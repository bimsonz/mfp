              },
              {
                "type": "null"
              }
            ],
            "description": "The commit the anchor was read at. Absent means the commit the driver is working against."
          }
        },
        "required": [
          "kind",
          "path",
          "symbol",
          "commit"
        ],
        "description": "A code location the claim rests on.",
        "additionalProperties": false
      },
      "ArrayShape": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "array"
            ]
          },
          "items": {
            "$ref": "#/$defs/Shape"
          }
        },
        "required": [
          "type",
          "items"
        ],
        "additionalProperties": false
      },
      "AuthorityPremise": {
        "type": "object",
        "properties": {
          "subject": {
            "$ref": "#/$defs/SubjectKey"
          },
          "predicate": {
            "type": "string",
