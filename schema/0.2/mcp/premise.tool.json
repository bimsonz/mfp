              },
              {
                "type": "null"
              }
            ],
            "description": "The holder's kind of reliance, not a confidence. `must`: the holder breaks\nif the proposition is false. `should`: it degrades. Comparison never reads it."
          },
          "scope": {
            "anyOf": [
              {
                "$ref": "#/$defs/Scope"
              },
              {
