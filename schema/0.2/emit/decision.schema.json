{
  "type": "object",
  "properties": {
    "mfp": {
      "type": "string",
      "enum": [
        "0.2"
      ],
      "description": "The wire version."
    },
    "kind": {
      "type": "string",
      "enum": [
        "decision"
      ]
    },
    "question": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "chosen": {
      "$ref": "#/$defs/Text"
    },
    "rationale": {
      "$ref": "#/$defs/Text"
    },
    "alternatives": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Alternative"
      }
    },
    "reversible": {
      "type": "boolean"
    },
    "cites": {
      "$ref": "#/$defs/Citations"
    },
    "confidence": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        {
          "type": "null"
        }
      ],
      "description": "The model's own confidence in this report. An opinion about an opinion: it never carries weight."
    }
  },
  "required": [
    "mfp",
    "kind",
    "question",
    "chosen",
    "rationale",
    "alternatives",
    "reversible",
    "cites",
    "confidence"
  ],
  "description": "A choice the model made, why, and what it rejected.",
  "additionalProperties": false,
  "$defs": {
    "Alternative": {
      "type": "object",
      "properties": {
        "option": {
          "$ref": "#/$defs/Text"
        },
        "reasonRejected": {
          "$ref": "#/$defs/Text"
        }
      },
      "required": [
        "option",
        "reasonRejected"
      ],
      "additionalProperties": false
    },
    "AnchorCitation": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "anchor"
          ]
        },
        "path": {
          "type": "string",
          "description": "Repository-relative path."
        },
        "symbol": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "A symbol within the file, e.g. a function or class name."
        },
        "commit": {
          "anyOf": [
            {
              "$ref": "#/$defs/CommitId"
            },
            {
              "type": "null"
            }
          ],
          "description": "The commit the anchor was read at. Absent means the commit the driver is working against."
        }
      },
      "required": [
        "kind",
        "path",
        "symbol",
        "commit"
      ],
      "description": "A code location the claim rests on.",
      "additionalProperties": false
    },
    "Citation": {
      "anyOf": [
        {
          "$ref": "#/$defs/AnchorCitation"
        },
        {
          "$ref": "#/$defs/MessageCitation"
        },
        {
          "$ref": "#/$defs/ToolResultCitation"
        },
        {
          "$ref": "#/$defs/RecordCitation"
        }
      ],
      "description": "What a claim rests on."
    },
    "Citations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Citation"
      },
      "minItems": 1,
      "description": "A citation list that must not be empty."
    },
    "CommitId": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$",
      "description": "A git object id: 40 lowercase hex digits (SHA-1) or 64 (SHA-256)."
    },
    "MessageCitation": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "message"
          ]
        },
        "ref": {
          "$ref": "#/$defs/Ref"
        }
      },
      "required": [
        "kind",
        "ref"
      ],
      "description": "A message in the conversation, by the identifier the driver gave it.",
      "additionalProperties": false
    },
    "RecordCitation": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "record"
          ]
        },
        "ref": {
          "$ref": "#/$defs/Ref"
        }
      },
      "required": [
        "kind",
        "ref"
      ],
      "description": "An earlier MFP message, by the identifier its receiver gave it.",
      "additionalProperties": false
    },
    "Ref": {
      "type": "string",
      "description": "An identifier the driver gave the model: a message, a tool call, an earlier\nMFP message or a decision. A model never invents one."
    },
    "Text": {
      "type": "string",
      "pattern": "\\S",
      "description": "Text a reader is meant to read: at least one non-space character."
    },
    "ToolResultCitation": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "tool-result"
          ]
        },
        "ref": {
          "$ref": "#/$defs/Ref"
        }
      },
      "required": [
        "kind",
        "ref"
      ],
      "description": "The result of a tool call, by the call's identifier.",
      "additionalProperties": false
    }
  }
}
