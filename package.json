{
  "name": "@bimsonz/mfp",
  "version": "0.2.0",
  "description": "MFP, the Model Feedback Protocol: the language a model speaks back to whatever drives it",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bimsonz/mfp.git"
  },
  "packageManager": "pnpm@11.18.0",
  "tspMain": "schema/0.2/main.tsp",
  "exports": {
    ".": {
      "typespec": "./schema/0.2/main.tsp",
      "default": "./schema/0.2/mfp.schema.json"
    },
    "./schema/0.2/*": "./schema/0.2/*",
    "./profile": {
      "types": "./lib/profile.d.ts",
      "default": "./lib/profile.js"
    },
    "./emit": {
      "types": "./lib/emit.d.ts",
      "default": "./lib/emit.js"
    }
  },
  "bin": {
    "mfp-profile": "./bin/mfp-profile.js"
  },
  "files": [
    "schema/0.2/main.tsp",
    "schema/0.2/*.json",
    "lib",
    "bin"
  ],
  "scripts": {
    "build": "node scripts/build.ts",
    "check:drift": "pnpm build && git diff --exit-code -- schema && test -z \"$(git ls-files --others --exclude-standard -- schema)\"",
    "conformance": "vitest run",
    "typecheck": "tsc",
    "lint": "oxlint",
    "eval:worker": "wrangler dev --config eval/worker/wrangler.jsonc --port 8787",
    "eval:run": "node eval/run.ts",
    "eval:summarize": "node eval/summarize.ts"
  },
  "peerDependencies": {
    "@typespec/compiler": "^1.17.0",
    "@typespec/json-schema": "^1.17.0"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@typespec/compiler": "1.17.0",
    "@typespec/json-schema": "1.17.0",
    "oxlint": "1.87.0",
    "typescript": "7.0.2",
    "vitest": "5.0.3",
    "wrangler": "4.149.0"
  }
}
