{
  "name": "mfp_verdict",
  "title": "Report a verdict",
  "description": "Report the outcome you think a piece of work should have (accept, revise, reject, defer), with your reasons. It is your opinion and decides nothing. Call this when you finish reviewing a piece of work.",
  "inputSchema": {
    "type": "object",
    "description": "The outcome the model thinks a piece of work should have. An opinion, never a ruling.",
    "additionalProperties": false,
    "properties": {
      "outcome": {
        "type": "string",
        "enum": [
          "accept",
          "revise",
          "reject",
          "defer"
        ],
        "description": "The outcome, as a token. The core profile's vocabulary is `accept`,\n`revise`, `reject` and `defer`; a profile may replace it."
      },
      "reasons": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/Reason"
        },
        "minItems": 1
      },
      "residualRisk": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "description": "What could still go wrong if the outcome is taken."
      },
      "cites": {
        "anyOf": [
          {
            "type": "array",
            "items": {
              "$ref": "#/$defs/Citation"
            }
          },
          {
            "type": "null"
          }
        ]
      },
      "confidence": {
        "anyOf": [
          {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          {
            "type": "null"
          }
        ],
        "description": "The model's own confidence in this report. An opinion about an opinion: it never carries weight."
      }
    },
    "required": [
      "outcome",
      "reasons",
      "residualRisk",
      "cites",
      "confidence"
    ],
    "$defs": {
      "AnchorCitation": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "anchor"
            ]
          },
          "path": {
            "type": "string",
            "description": "Repository-relative path."
          },
          "symbol": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "A symbol within the file, e.g. a function or class name."
          },
          "commit": {
            "anyOf": [
              {
                "$ref": "#/$defs/CommitId"
              },
              {
                "type": "null"
              }
            ],
            "description": "The commit the anchor was read at. Absent means the commit the driver is working against."
          }
        },
        "required": [
          "kind",
          "path",
          "symbol",
          "commit"
        ],
        "description": "A code location the claim rests on.",
        "additionalProperties": false
      },
      "Citation": {
        "anyOf": [
          {
            "$ref": "#/$defs/AnchorCitation"
          },
          {
            "$ref": "#/$defs/MessageCitation"
          },
          {
            "$ref": "#/$defs/ToolResultCitation"
          },
          {
            "$ref": "#/$defs/RecordCitation"
          }
        ],
        "description": "What a claim rests on."
      },
      "CommitId": {
        "type": "string",
        "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$",
        "description": "A git object id: 40 lowercase hex digits (SHA-1) or 64 (SHA-256)."
      },
      "MessageCitation": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "message"
            ]
          },
          "ref": {
            "$ref": "#/$defs/Ref"
          }
        },
        "required": [
          "kind",
          "ref"
        ],
        "description": "A message in the conversation, by the identifier the driver gave it.",
        "additionalProperties": false
      },
      "Reason": {
        "type": "object",
        "properties": {
          "summary": {
            "$ref": "#/$defs/Text"
          },
          "cites": {
            "anyOf": [
              {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/Citation"
                }
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "summary",
          "cites"
        ],
        "additionalProperties": false
      },
      "RecordCitation": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "record"
            ]
          },
          "ref": {
            "$ref": "#/$defs/Ref"
          }
        },
        "required": [
          "kind",
          "ref"
        ],
        "description": "An earlier MFP message, by the identifier its receiver gave it.",
        "additionalProperties": false
      },
      "Ref": {
        "type": "string",
        "description": "An identifier the driver gave the model: a message, a tool call, an earlier\nMFP message or a decision. A model never invents one."
      },
      "Text": {
        "type": "string",
        "pattern": "\\S",
        "description": "Text a reader is meant to read: at least one non-space character."
      },
      "ToolResultCitation": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "tool-result"
            ]
          },
          "ref": {
            "$ref": "#/$defs/Ref"
          }
        },
        "required": [
          "kind",
          "ref"
        ],
        "description": "The result of a tool call, by the call's identifier.",
        "additionalProperties": false
      }
    }
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "ref": {
        "type": "string",
        "description": "The identifier the receiver gave this report. Cite it later as {kind: \"record\", ref}."
      }
    },
    "required": [
      "ref"
    ],
    "additionalProperties": false
  },
  "annotations": {
    "title": "Report a verdict",
    "readOnlyHint": false,
    "destructiveHint": false,
    "idempotentHint": false,
    "openWorldHint": false
  }
}
