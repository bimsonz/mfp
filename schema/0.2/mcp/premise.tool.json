{
  "name": "mfp_premise",
  "title": "Report a premise",
  "description": "Report one more thing you rely on about code you do not own, found after you reported your intent. Call this as soon as you start relying on it.",
  "inputSchema": {
    "type": "object",
    "description": "One more thing the model relies on, after its intent.",
    "additionalProperties": false,
    "properties": {
      "premise": {
        "$ref": "#/$defs/PremiseProposition"
      },
      "cites": {
        "anyOf": [
          {
            "type": "array",
            "items": {
              "$ref": "#/$defs/Citation"
            }
          },
          {
            "type": "null"
          }
        ]
      },
      "confidence": {
        "anyOf": [
          {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          {
            "type": "null"
          }
        ],
        "description": "The model's own confidence in this report. An opinion about an opinion: it never carries weight."
      }
    },
    "required": [
      "premise",
      "cites",
      "confidence"
    ],
    "$defs": {
      "Anchor": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "Repository-relative path."
          },
          "symbol": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "A symbol within the file, e.g. a function or class name."
          },
          "commit": {
            "anyOf": [
              {
                "$ref": "#/$defs/CommitId"
              },
              {
                "type": "null"
              }
            ],
            "description": "The commit the anchor was read at. Absent means the commit the driver is working against."
          }
        },
        "required": [
          "path",
          "symbol",
          "commit"
        ],
        "description": "A path, and optionally a symbol, in the repository, optionally pinned to a commit.",
        "additionalProperties": false
      },
      "AnchorCitation": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "anchor"
            ]
          },
          "path": {
            "type": "string",
            "description": "Repository-relative path."
          },
          "symbol": {
            "anyOf": [
              {
                "type": "string"
              },
              {
